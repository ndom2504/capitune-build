# Copy to .env.local. Never commit real secrets.

# HMAC secret for local session cookies. Change in any shared environment.
SESSION_SECRET=replace-with-a-long-random-string

# Persistence: local JSON (default) or supabase.
DATA_STORE=local
DATA_FILE=.data/store.json

# Optional live AI. If AI_API_KEY is empty, Capitune uses deterministic demo mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Canonical public URL (production). Avoids Google OAuth returning to Site URL `/`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional isolated preview origin (same Vercel project, different host, no session cookies).
# Example: https://preview.capitune.com — leave empty to serve /p/… on the app origin.
NEXT_PUBLIC_PREVIEW_ORIGIN=

# Supabase Auth + Postgres. Required when DATA_STORE=supabase.
# Create a free project, run supabase/migrations/0001_init.sql, then fill these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Stripe billing (Pro). Leave empty to keep Pro as “coming soon”.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
